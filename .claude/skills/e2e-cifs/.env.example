# 复制为 .env 并填入真实值。.env 不进 git。
# role-based CIFS backend 只支持 NTLM 凭据；没有 URL / smb2_only / anon。
CIFS_REAL_SERVER=YOUR_SOURCE_LIF_OR_HOST
CIFS_REAL_SECOND_SERVER=YOUR_DESTINATION_LIF_OR_HOST   # 可选，缺省 = CIFS_REAL_SERVER
CIFS_REAL_SHARE=YOUR_SHARE
CIFS_REAL_USER=YOUR_USER
CIFS_REAL_PASS=YOUR_PASSWORD
# 可选：逗号分隔的 policy contract 文件大小
CIFS_POLICY_TEST_BYTES=
# 可选：同一卷的 NFS 导出，probe 用它创建 UNIX symlink fixture (WSL2 NAT 下服务端需允许非特权端口)
CIFS_PROBE_NFS_URL=
# 可选：allow-unsigned 时接受 guest/匿名会话 (未知用户 + 空密码，或空用户名)
CIFS_REAL_GUEST_POLICY=
# 可选：停车列举测试 (P7 C9) 首页后空闲的秒数，缺省 2
CIFS_PARKED_IDLE_SECS=
# 可选：只读 share (账号在 share ACL 上只有 read)，里面放好只读夹具；设了才跑 cifs_readonly_contract
CIFS_REAL_RO_SHARE=
