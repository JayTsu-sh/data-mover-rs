NFS_HOST=YOUR_NFS_HOST
NFS_PORT=2049
NFS_EXPORT=/data
NFS_UID=1000
NFS_GID=1000

# 可选：export 下一个 NFS_UID 读不了的目录（相对 export，服务器侧 0700 属 root）
NFS_DENY_DIR=
# 可选：原样追加到 URL 查询串，例如 'version=4.1&noresvport=true'（含 & 必须加单引号）
NFS_OPTIONS=
# 可选：只遍历 export 下这个子目录
NFS_WALK_PATH=

# ACL / xattr 拷贝策略矩阵 (scripts/metadata_matrix.sh)
# 可写的 NFSv4.1 导出，不带 `:` 子路径；脚本在其下建 dm-meta-<run>/ 并在结束时删除
NFS_META_V41_EXPORT='nfs://YOUR_NFS_HOST/export?version=4.1&noresvport=true&uid=0&gid=0'
# 可选：NFSv3 源（只读使用）与其下一个已存在的文件
NFS_META_V3_URL=
NFS_META_V3_FILE=
